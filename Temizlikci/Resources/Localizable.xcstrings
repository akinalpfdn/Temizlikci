      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here is a developer cache or build folder, so there's nothing to highlight."
          }
        }
      }
    },
    "cleanup.reason.androidEmulators": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android emulators. Remove them in Android Studio’s Device Manager."
          }
        }
      }
    },
    "cleanup.reason.androidSystemImages": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android system images. Remove them in Android Studio’s SDK Manager."
          }
        }
      }
    },
    "cleanup.reason.appData": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data that belongs to other apps, such as messages and documents. Clear it inside each app."
          }
        }
      }
    },
    "cleanup.reason.archives": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds you archived for distribution. Their debug symbols are needed to read crash reports, so keep the ones you still support."
          }
        }
      }
    },
    "cleanup.reason.bunCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bun’s install cache. Bun downloads packages again as needed."
          }
        }
      }
    },
    "cleanup.reason.cargoRegistry": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded crates. Cargo restores anything a build needs, by re-extracting or downloading it again."
          }
        }
      }
    },
    "cleanup.reason.cargoTarget": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust build output. Running cargo build recreates it."
          }
        }
      }
    },
    "cleanup.reason.cocoapodsCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded pods. Running pod install downloads them again."
          }
        }
      }
    },
    "cleanup.reason.dartTool": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dart tooling state. Running flutter pub get recreates it."
          }
        }
      }
    },
    "cleanup.reason.derivedData": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build products and indexes. Xcode rebuilds them on the next build."
          }
        }
      }
    },
    "cleanup.reason.deviceSupport": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug symbols copied from your devices. Xcode copies them again the next time a device connects."
          }
        }
      }
    },
    "cleanup.reason.docker": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker’s disk image, holding every image, container and volume. Reclaim space with docker system prune; deleting the file loses all of it."
          }
        }
      }
    },
    "cleanup.reason.documentationCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded documentation. Xcode downloads it again when needed."
          }
        }
      }
    },
    "cleanup.reason.electronCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded Electron binaries. They are fetched again on the next install."
          }
        }
      }
    },
    "cleanup.reason.flutterBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutter build output. Building the project recreates it."
          }
        }
      }
    },
    "cleanup.reason.goBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go’s build cache. Go rebuilds it as needed."
          }
        }
      }
    },
    "cleanup.reason.goModCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded Go modules, stored read-only. Remove them with go clean -modcache."
          }
        }
      }
    },
    "cleanup.reason.gradleBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle build output for this project. The next build recreates it."
          }
        }
      }
    },
    "cleanup.reason.gradleCaches": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle’s download and build caches. Gradle fetches them again on the next build."
          }
        }
      }
    },
    "cleanup.reason.homebrewCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew downloads. Homebrew fetches them again when needed."
          }
        }
      }
    },
    "cleanup.reason.jetbrains": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches and indexes of JetBrains IDEs. They are rebuilt when you open a project."
          }
        }
      }
    },
    "cleanup.reason.maven": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded Java dependencies. Maven downloads them again on the next build."
          }
        }
      }
    },
    "cleanup.reason.nextBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next.js build cache. The next build recreates it."
          }
        }
      }
    },
    "cleanup.reason.nodeGyp": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node headers kept for building native modules. They are downloaded again when needed."
          }
        }
      }
    },
    "cleanup.reason.nodeModules": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed npm packages. Running npm install restores them."
          }
        }
      }
    },
    "cleanup.reason.npmCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm’s download cache. npm refills it as you install packages."
          }
        }
      }
    },
    "cleanup.reason.nuget": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracted NuGet packages that projects reference directly. Clear them with dotnet nuget locals global-packages --clear, then restore your projects."
          }
        }
      }
    },
    "cleanup.reason.pipCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pip’s download cache. Clear it with pip cache purge, or remove it here — pip downloads packages again as needed."
          }
        }
      }
    },
    "cleanup.reason.playwright": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browsers downloaded for Playwright tests. Running playwright install downloads them again."
          }
        }
      }
    },
    "cleanup.reason.pnpmStore": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm’s package store, which every node_modules folder links into. Use pnpm store prune, which only removes what nothing references."
          }
        }
      }
    },
    "cleanup.reason.pods": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencies installed for this project. Running pod install restores them."
          }
        }
      }
    },
    "cleanup.reason.previews": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI preview builds. Xcode recreates them when you open a preview."
          }
        }
      }
    },
    "cleanup.reason.pubCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded Dart and Flutter packages. Running flutter pub get downloads them again."
          }
        }
      }
    },
    "cleanup.reason.rustup": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed Rust toolchains, not a cache. Remove ones you don’t need with rustup toolchain uninstall."
          }
        }
      }
    },
    "cleanup.reason.simulatorDevices": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator devices and their data. Remove them with Xcode’s simulator tool so Xcode’s device list stays consistent."
          }
        }
      }
    },
    "cleanup.reason.simulatorRuntimes": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator runtimes. Remove them with Xcode’s simulator tool or in Xcode › Settings › Components."
          }
        }
      }
    },
    "cleanup.reason.swiftpmBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift package build output. The next build recreates it."
          }
        }
      }
    },
    "cleanup.reason.swiftpmCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager’s download cache. Building a package fetches what it needs again."
          }
        }
      }
    },
    "cleanup.reason.unityLibrary": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unity’s imported asset cache for this project. Unity rebuilds it when you open the project, which can take a while."
          }
        }
      }
    },
    "cleanup.reason.uvCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "uv’s cache. uv states it is never safe to delete by hand; run uv cache clean instead."
          }
        }
      }
    },
    "cleanup.reason.xcodeCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode’s own cache. Xcode refills it as you work."
          }
        }
      }
    },
    "cleanup.reason.yarnCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn’s package cache. Yarn downloads packages again as needed."
          }
        }
      }
    },
