{
  "sourceLanguage": "en",
  "strings": {
    "access.banner.message": {
      "comment": "Banner message. The argument is how many folders were skipped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci didn’t open %@ protected folders, such as Documents and Mail, so their space is counted in Other Used Space."
          }
        }
      }
    },
    "access.banner.notNow": {
      "comment": "Button that hides the access banner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        }
      }
    },
    "access.banner.openSettings": {
      "comment": "Button that opens Full Disk Access in System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Privacy Settings…"
          }
        }
      }
    },
    "access.banner.relaunch": {
      "comment": "Hint in the access banner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After turning on access for Temizlikci, quit and reopen it, then scan again."
          }
        }
      }
    },
    "access.banner.title": {
      "comment": "Title of the banner shown when protected folders were skipped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some Folders Need Full Disk Access"
          }
        }
      }
    },
    "alert.cancel": {
      "comment": "Button that cancels an alert's action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "alert.ok": {
      "comment": "Button that dismisses an informational alert.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "app.name": {
      "comment": "The app's name. Keep it untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci"
          }
        }
      }
    },
    "chart.accessibility.label": {
      "comment": "Accessibility label of the sunburst chart. The argument is the folder name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk usage of %@"
          }
        }
      }
    },
    "chart.accessibility.summary": {
      "comment": "Audio Graphs summary. Arguments: folder, its size, largest item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses %@. The largest item is %@."
          }
        }
      }
    },
    "chart.action.open": {
      "comment": "Action that shows a folder's contents in the chart.",
      "extractionState": "manual",
      "localizations": {
