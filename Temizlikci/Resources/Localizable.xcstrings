      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "chart.center.goUp": {
      "comment": "Accessibility label of the chart center, which opens the enclosing folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go up to %@"
          }
        }
      }
    },
    "chart.center.measuredSoFar": {
      "comment": "Chart center caption while a scan is running.",
