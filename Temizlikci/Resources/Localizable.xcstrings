      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight Reclaimable"
          }
        }
      }
    },
    "toolbar.inspector": {
      "comment": "Toolbar button that shows or hides the inspector.",
