{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "comment": "The app's name. Keep it untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci"
          }
        }
      }
    },
    "chart.accessibility.label": {
      "comment": "Accessibility label of the sunburst chart. The argument is the folder name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk usage of %@"
          }
        }
      }
    },
    "chart.accessibility.summary": {
      "comment": "Audio Graphs summary. Arguments: folder, its size, largest item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses %@. The largest item is %@."
          }
        }
      }
    },
    "chart.action.open": {
      "comment": "Action that shows a folder's contents in the chart.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "chart.announcement.opened": {
      "comment": "VoiceOver announcement after opening a folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened %@"
          }
        }
      }
    },
    "chart.axis.items": {
      "comment": "Audio Graphs axis listing the items in the folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items"
          }
        }
      }
    },
    "chart.axis.size": {
      "comment": "Audio Graphs axis for space on disk.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "chart.center.goUp": {
      "comment": "Accessibility label of the chart center, which opens the enclosing folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go up to %@"
          }
        }
      }
    },
    "chart.center.measuredSoFar": {
      "comment": "Chart center caption while a scan is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "measured so far"
          }
        }
      }
    },
    "chart.center.shareOf": {
      "comment": "Chart center caption. Arguments: a percentage, the containing folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "chart.center.usedOfVolume": {
      "comment": "Chart center caption under the used size of a disk. The argument is the disk capacity.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "used of %@"
          }
        }
      }
    },
    "details.explain.inaccessible": {
      "comment": "Inspector explanation for a protected folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci can’t read this folder without Full Disk Access, so its size isn’t included."
          }
        }
      }
    },
    "details.explain.pending": {
      "comment": "Inspector explanation for space not scanned yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part of the disk hasn’t been measured yet."
          }
        }
      }
    },
    "details.explain.smallerFiles": {
      "comment": "Inspector explanation for grouped small files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files under 10 MB in this folder, added together."
          }
        }
      }
    },
    "details.explain.unattributed": {
      "comment": "Inspector explanation for unattributed space.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space macOS reports as used that no scanned folder accounts for: folders Temizlikci can’t read without Full Disk Access, the system volume’s hidden parts, APFS snapshots, and purgeable files."
          }
        }
      }
    },
    "details.files": {
      "comment": "Inspector label for the number of files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
