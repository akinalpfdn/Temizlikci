      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "chart.center.usedOfVolume": {
      "comment": "Chart center caption under the used size of a disk. The argument is the disk capacity.",
