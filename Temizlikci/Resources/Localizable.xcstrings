    "growth.appeared.help": {
      "comment": "Explains an item that wasn't recorded in the previous scan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New, or under 100 MB in the previous scan."
