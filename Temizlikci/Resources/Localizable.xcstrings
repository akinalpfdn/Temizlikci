      "comment": "Size that can be removed in a group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclaimable"
          }
        }
      }
    },
    "cleanup.highlight": {
      "comment": "Toolbar toggle and menu item that colors the chart by cleanup safety.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight Reclaimable"
          }
        }
      }
    },
    "cleanup.reason.androidEmulators": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android emulators. Remove them in Android Studio’s Device Manager."
          }
        }
      }
    },
    "cleanup.reason.androidSystemImages": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android system images. Remove them in Android Studio’s SDK Manager."
          }
        }
      }
    },
    "cleanup.reason.appData": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data that belongs to other apps, such as messages and documents. Clear it inside each app."
          }
        }
      }
    },
    "cleanup.reason.archives": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds you archived for distribution. Their debug symbols are needed to read crash reports, so keep the ones you still support."
          }
        }
      }
    },
    "cleanup.reason.dartTool": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dart tooling state. Running flutter pub get recreates it."
          }
        }
      }
    },
    "cleanup.reason.derivedData": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build products and indexes. Xcode rebuilds them on the next build."
          }
        }
      }
    },
    "cleanup.reason.deviceSupport": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug symbols copied from your devices. Xcode copies them again the next time a device connects."
          }
        }
      }
    },
    "cleanup.reason.documentationCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded documentation. Xcode downloads it again when needed."
          }
        }
      }
    },
    "cleanup.reason.flutterBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutter build output. Building the project recreates it."
          }
        }
      }
    },
    "cleanup.reason.goBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go’s build cache. Go rebuilds it as needed."
          }
        }
      }
    },
    "cleanup.reason.gradleCaches": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle’s download and build caches. Gradle fetches them again on the next build."
          }
        }
      }
    },
    "cleanup.reason.homebrewCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew downloads. Homebrew fetches them again when needed."
          }
        }
      }
    },
    "cleanup.reason.nextBuild": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next.js build cache. The next build recreates it."
          }
        }
      }
    },
    "cleanup.reason.nodeModules": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed npm packages. Running npm install restores them."
          }
        }
      }
    },
    "cleanup.reason.npmCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm’s download cache. npm refills it as you install packages."
          }
        }
      }
    },
    "cleanup.reason.previews": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI preview builds. Xcode recreates them when you open a preview."
          }
        }
      }
    },
    "cleanup.reason.pubCache": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded Dart and Flutter packages. Running flutter pub get downloads them again."
          }
        }
      }
    },
    "cleanup.reason.simulatorDevices": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator devices and their data. Remove them with Xcode’s simulator tool so Xcode’s device list stays consistent."
          }
        }
      }
    },
    "cleanup.reason.simulatorRuntimes": {
      "comment": "Why an item has its cleanup label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator runtimes. Remove them with Xcode’s simulator tool or in Xcode › Settings › Components."
          }
        }
      }
    },
    "cleanup.safety.keep": {
      "comment": "Label for items that hold personal data and shouldn't be deleted here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        }
      }
    },
    "cleanup.safety.safe": {
      "comment": "Label for items that regenerate on their own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe to Remove"
          }
        }
      }
    },
    "cleanup.safety.tool": {
      "comment": "Label for items that must be removed with their own tool.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove with Tool"
          }
        }
      }
    },
    "details.explain.inaccessible": {
      "comment": "Inspector explanation for a protected folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci can’t read this folder without Full Disk Access, so its size isn’t included."
          }
        }
      }
    },
    "details.explain.pending": {
      "comment": "Inspector explanation for space not scanned yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part of the disk hasn’t been measured yet."
          }
        }
      }
    },
    "details.explain.smallerFiles": {
      "comment": "Inspector explanation for grouped small files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files under 10 MB in this folder, added together."
          }
        }
      }
    },
    "details.explain.unattributed": {
      "comment": "Inspector explanation for unattributed space.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space macOS reports as used that no scanned folder accounts for: folders Temizlikci can’t read without Full Disk Access, items in the Trash, the system volume’s hidden parts, APFS snapshots, and purgeable files."
          }
        }
      }
    },
    "details.files": {
      "comment": "Inspector label for the number of files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
    "details.modified": {
