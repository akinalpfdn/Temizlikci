          }
        }
      }
    },
    "growth.empty.message": {
      "comment": "Explanation when there's only one scan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci keeps a small summary of every scan on this Mac. Scan the same location again later to see what grew."
          }
        }
      }
    },
    "growth.empty.title": {
      "comment": "Title when there's only one scan.",
