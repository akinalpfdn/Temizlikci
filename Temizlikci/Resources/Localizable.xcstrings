    "details.explain.inaccessible": {
      "comment": "Inspector explanation for a protected folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlikci can’t read this folder without Full Disk Access, so its size isn’t included."
          }
        }
      }
    },
    "details.explain.pending": {
      "comment": "Inspector explanation for space not scanned yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used space the scan hasn’t reached yet. It shrinks as folders are measured and is gone when the scan finishes; anything still unexplained then becomes Other Used Space."
          }
        }
      }
    },
    "details.explain.smallerFiles": {
      "comment": "Inspector explanation for grouped small files.",
      "extractionState": "manual",
