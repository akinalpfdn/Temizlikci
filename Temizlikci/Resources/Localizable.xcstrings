      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ since %@"
          }
        }
      }
    },
    "growth.inspector.label": {
      "comment": "Inspector label for the size change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change since %@"
          }
        }
      }
    },
    "growth.noChanges.message": {
      "comment": "Message when nothing changed much.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changed by more than 10 MB since %@."
