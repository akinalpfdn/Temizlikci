      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        }
      }
    },
    "sidebar.section.insights": {
      "comment": "Sidebar section listing analysis views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights"
          }
        }
      }
    },
    "sidebar.section.locations": {
      "comment": "Sidebar section listing places that can be scanned.",
      "extractionState": "manual",
      "localizations": {
